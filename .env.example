# Comptes PostgreSQL distincts. Le runtime ne doit jamais être superutilisateur.
DATABASE_URL=postgresql://ciblix_runtime:CHANGE_ME@127.0.0.1:55439/ciblix
MIGRATION_DATABASE_URL=postgresql://ciblix_owner:CHANGE_ME@127.0.0.1:55439/ciblix
APP_URL=http://localhost:3000
PORT=3000
NODE_ENV=development
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Client OAuth Gmail, distinct de la connexion Better Auth ci-dessus.
GMAIL_GOOGLE_CLIENT_ID=
GMAIL_GOOGLE_CLIENT_SECRET=
GMAIL_GOOGLE_REDIRECT_URI=https://ciblix.com/api/v1/gmail/callback
# Extraction documentaire (Gemini). Clé serveur uniquement — jamais exposée au navigateur.
DOCUMENT_AI_PROVIDER=gemini
DOCUMENT_AI_API_KEY=
DOCUMENT_AI_MODEL=gemini-2.5-flash
DOCUMENT_AI_MAX_BYTES=8388608
DOCUMENT_AI_MAX_PAGES=5
DOCUMENT_AI_ORG_DAILY_LIMIT=20
DOCUMENT_AI_MONTHLY_BUDGET_USD=10
# Jamais d’activation de comptes de test dans le serveur applicatif.
# Secret stable requis pour Better Auth (au moins 32 caractères aléatoires).
BETTER_AUTH_SECRET=
# Superadmin plateforme : node scripts/grant-superadmin.js adresse@example.com
# Le compte doit déjà exister. Cette commande n’affiche pas le mot de passe.
# En production : SMTP d’un fournisseur déjà autorisé. En local : Mailpit.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=
