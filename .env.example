# Comptes PostgreSQL distincts. Le runtime ne doit jamais être superutilisateur.
DATABASE_URL=postgresql://ciblix_runtime:CHANGE_ME@127.0.0.1:55439/ciblix
MIGRATION_DATABASE_URL=postgresql://ciblix_owner:CHANGE_ME@127.0.0.1:55439/ciblix
APP_URL=http://localhost:3000
PORT=3000
NODE_ENV=development
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Jamais d’activation de comptes de test dans le serveur applicatif.
# Secret stable requis pour Better Auth (au moins 32 caractères aléatoires).
BETTER_AUTH_SECRET=
# En production : SMTP d’un fournisseur déjà autorisé. En local : Mailpit.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=
